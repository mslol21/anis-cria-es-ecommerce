# ==============================================================================
# ANIS CRIAÇÕES - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# 1. URL Pública da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Anis Criações"

# 2. Supabase (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY deve ser usada EXCLUSIVAMENTE no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# 3. InfinitePay Checkout API Oficial Brasileira
# Documentação oficial: https://www.infinitepay.io/checkout-documentacao
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_HANDLE=sua-infinite-tag
INFINITEPAY_WEBHOOK_SECRET=segredo-validacao-webhook-opcional

# 4. Melhor Envio API Oficial
# Sandbox: https://sandbox.melhorenvio.com.br | Produção: https://melhorenvio.com.br
MELHOR_ENVIO_API_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_ACCESS_TOKEN=seu-bearer-token-melhor-envio
MELHOR_ENVIO_USER_AGENT="AnisCriacoesEcommerce/1.0 (contato@aniscriacoes.com.br)"
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=01310100
MELHOR_ENVIO_AUTO_PURCHASE_ENABLED=false

# 5. Segurança Interna e Jobs de Conciliação
CRON_RECONCILIATION_SECRET=segredo-interno-para-cron-de-conciliacao
